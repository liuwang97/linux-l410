menu "Hisilicon SoC drivers"
	depends on ARCH_HISI || COMPILE_TEST

config KIRIN_HW_VOTE
	bool "HiSilicon Kirin 990 hardware vote (PMCTRL)"
	depends on ARCH_HISI || COMPILE_TEST
	depends on OF && HAS_IOMEM
	help
	  Frequency and voltage requests to the LPM3 power controller of the
	  HiSilicon Kirin 990 (Huawei Qingyun L410), used by cpufreq and the
	  peripheral DVFS code.

config KIRIN_PERI_DVFS
	bool "HiSilicon Kirin 990 peripheral voltage voting"
	depends on KIRIN_HW_VOTE && HWSPINLOCK
	help
	  Lets the Kirin 990 clock driver raise the shared peripheral rail
	  before fast peripheral clocks are enabled (vendor "peri DVFS"),
	  through PMCTRL and the LPM3 hardware vote.

config KUNPENG_HCCS
	tristate "HCCS driver on Kunpeng SoC"
	depends on ACPI
	depends on PCC
	depends on ARM64 || COMPILE_TEST
	help
	  The Huawei Cache Coherence System (HCCS) is a multi-chip
	  interconnection bus protocol.
	  The performance of application may be affected if some HCCS
	  ports are not in full lane status, have a large number of CRC
	  errors and so on. This may support for reducing system power
	  consumption if there are HCCS ports supported low power feature
	  on platform.

	  Say M here if you want to include support for querying the
	  health status and port information of HCCS, or reducing system
	  power consumption on Kunpeng SoC.

config L410_DEADMAN
	bool "Huawei L410 bring-up deadman watchdog"
	depends on ARM64
	help
	  Arms the Kirin 990 AP SP805 watchdog early in boot and never pets it,
	  so a hung or unreachable test kernel resets the machine back to the
	  default boot entry. Only useful while bringing up new kernels on the
	  Huawei L410; boot with l410_deadman=0 to disable.

config KIRIN990_SUSPEND
	bool "HiSilicon Kirin 990 system suspend"
	depends on ARM64 && ARM_PSCI_FW && CPU_IDLE && SUSPEND
	help
	  Enter "deep" system suspend the way the vendor kernel does: flag
	  the suspend in SCTRL and enter the cluster sleep state, so the
	  firmware hands the system to LPM3.  Without this, "deep" is PSCI
	  SYSTEM_SUSPEND, which this firmware never supported in practice.
	  The board does not resume from it yet, so suspend-to-idle stays
	  the default; kirin990_sr.deep=1 makes "deep" the default.

config L410_PERF
	bool "Huawei L410 performance modes and interaction boosts"
	depends on ARM64 && CPU_FREQ && PM && INPUT && OF
	help
	  Power / balanced / performance modes for the Kirin 990 (Huawei
	  Qingyun L410) and short CPU, GPU and memory frequency floors while
	  the user interacts, starts an application or an animation runs
	  (input boost, launch boost). Uses the PM QoS interfaces only, so
	  thermal limits always win. Controlled from /sys/kernel/l410_perf/.

endmenu

				hisilicon,hisi-off-on-delay-us = <0x4e20>;
				hisilicon,hisi-enable-time-us = <0x168>;
				hisilicon,valid-modes-mask = <0x02>;
				hisilicon,vaild-idle-mask = <0x0d>;
				phandle = <0x5ab>;
			};
		};

		pmic@0 {
			compatible = "hisilicon-hisi-pmic-spmi";
			slave_id = <0x09>;
			handle_irq;
			#interrupt-cells = <0x02>;
			interrupt-controller;
			gpios = <0x35 0x06 0x00>;
			pinctrl-names = "default";
			pinctrl-0;
			hisilicon,hisi-pmic-irq-num = <0x28>;
			hisilicon,hisi-pmic-irq-array = <0x05>;
			hisilicon,hisi-pmic-irq-mask-addr = <0x2a2 0x2a3 0x2ac 0x2ad 0x2ae>;
			hisilicon,hisi-pmic-irq-addr = <0x2b3 0x2b4 0x2bd 0x2be 0x2bf>;
			hisilicon,hisi-pmic-vbus = <0x06 0x01>;
			hisilicon,hisi-pmic-lock = <0x1d5 0x7d>;
			hisilicon,hisi-pmic-debug-lock = <0x2eb 0x6c>;
			spmi-slave-container;
			phandle = <0x1fc>;
			hisilicon,pmic_fpga_flag = <0x00>;

			ponkey@b1 {
				compatible = "hisilicon-hisi-powerkey";
				interrupt-parent = <0x1fc>;
				interrupts = <0x07 0x00 0x04 0x00>;
				interrupt-names = "down", "hold 6s";
				interrupt-numbers = <0x02>;
				powerkey-type = <0x01>;
				status = "ok";
				phandle = <0x5ac>;
			};

			usbvbus {
				compatible = "hisilicon-usbvbus";
				interrupt-parent = <0x1fc>;
				interrupts = <0x01 0x00 0x02 0x00>;
				interrupt-names = "connect", "disconnect";
				status = "disabled";
			};


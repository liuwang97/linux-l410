	memory@0 {
		device_type = "memory";
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x2ca>;

		hisi_drm_debug_pool_heap {
			size = <0x00 0xec00000>;
			compatible = "hisi-drm-debug-pool";
			alignment = <0x00 0x400000>;
			status = "disabled";
		};

		app_no_allocate {
			reg = <0x00 0x00 0x00 0x1000>;
		};

		dmss-regs-backup {
			reg = <0x00 0x76800000 0x00 0x10000>;
			no-map;
		};

		mntndump {
			reg = <0x00 0x26dff000 0x00 0x1000>;
			no-map;
		};

		pstore-mem {
			reg = <0x00 0x26e00000 0x00 0x100000>;
			phandle = <0x243>;
		};

		bbox-mem {
			reg = <0x00 0x26f00000 0x00 0x860000>;
			no-map;
			phandle = <0xfd>;
		};

		secos-s4-mem {
			reg = <0x00 0x27760000 0x00 0x100000>;
		};

		fastboot-cma-mem {
			reg = <0x00 0x78000000 0x00 0x8000000>;
			compatible = "shared-dma-pool";
			hisi,cma-sec;
			sec-attr = <0x00 0x00>;
			linux,cma-default;
			reusable;
			status = "ok";
			visible_to_users;
			phandle = <0x1eb>;
		};
	};


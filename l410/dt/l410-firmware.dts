	spmi@FA890000 {
		compatible = "hisilicon,spmi-controller";
		status = "ok";
		reg = <0x00 0xfa890000 0x00 0x1000>;
		spmi-channel = <0x02>;
		phandle = <0x5a9>;
		spmi-always-sec;

		pmic1@1 {
			compatible = "hisilicon-hisi-sub-pmic-spmi";
			slave_id = <0x01>;
			spmi-slave-container;
			status = "disabled";
			phandle = <0x5aa>;

			buck01@AB {
				compatible = "hisilicon-hisi-sub-pmic-ldo";
				regulator-name = "buck01";
				regulator-min-microvolt = <0x493e0>;
				regulator-max-microvolt = <0x1312d0>;

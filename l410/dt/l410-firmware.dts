	hi110x {
		compatible = "hisilicon,hi110x", "hisilicon,hi1102";
		phandle = <0x6a0>;
		status = "ok";
		hi110x,subchip_type = "hi1103";
		hi110x,gpio_power_on = <0x4cf 0x01 0x00>;
		hi110x,gpio_bfgx_power_on = <0xfe 0x04 0x00>;
		hi110x,gpio_wlan_power_on = <0xfe 0x03 0x00>;
		hi110x,gpio_ssi_clk = <0x267 0x07 0x00>;
		hi110x,gpio_ssi_data = <0x24c 0x00 0x00>;
		huawei,pmu_clk32b = "clk_pmu32kb";
		hi110x,asic_version;
	};

	hisi_wifi {
		compatible = "hisilicon,hisi_wifi";
		phandle = <0x6a1>;
		status = "ok";
		hi110x,gpio_wlan_wakeup_host = <0x24c 0x05 0x00>;
		hi110x,gpio_host_wakeup_wlan = <0xfe 0x02 0x00>;
		hi110x,pcie_rc_idx = <0x01>;
		hi110x,gpio_sample_low = <0x00>;

		hisi_wifi_firmware {
			compatible = "hisi,wifi_firmware";
			status = "ok";
			firmware_type_num = "1";
		};

		hisi_wifi_supp {
			compatible = "hisi,wifi_supp";
			status = "ok";
			supp_config_template = "/vendor/etc/wifi/wpa_supplicant_hisi.conf";
		};

		hisi_wifi_p2p {
			compatible = "hisi,wifi_p2p";
			status = "ok";
			p2p_config_template = "/vendor/etc/wifi/p2p_supplicant_hisi.conf";
		};

		hisi_wifi_apd {
			compatible = "hisi,wifi_hostapd";
			status = "ok";
			hostapd_bin_file = "/vendor/bin/hostapd_hisi";
		};
	};

	hisi_bfgx {
		compatible = "hisilicon,hisi_bfgx";
		phandle = <0x6a2>;
		status = "ok";
		hi110x,gpio_bfgx_wakeup_host = <0x4cf 0x00 0x00>;
		hi110x,uart_port = "/dev/ttyAMA4";
	};

	hw_trans_keep_variable {
		compatible = "trans,keep_variable";
		status = "ok";
	};

	hw_trans_ac_recovery {
		compatible = "trans,ac_recovery";
		status = "ok";
	};

	hw_trans_bios_variable {
		compatible = "trans,bios_setup_variable";
		status = "ok";
		value = <0x00>;
	};

	hisi_cust_cfg {
		compatible = "hi110x,customize", "hi1102,customize";
		phandle = <0x6a3>;
		status = "ok";
		ini_file_name = "/vendor/etc/cfg_udp_1103_pilot.ini";
	};
};

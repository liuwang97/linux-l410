/dts-v1/;

/ {
	hisi,boardname = "KelvinX_Z00_VA";
	hisi,product_id = <0x36f5fc20>;
	hisi,modem_id = <0x36f5fc20>;
	hisi,boardid = <0x09 0x03 0x00 0x03 0x03 0x00 0x05>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "HUAWEI Kirin 990";
	compatible = "HUAWEI Kirin 990";
	interrupt-parent = <0x01>;
	hisi,gpu_vendor = "mali";
	hisi,chipid = <0x06 0x09 0x00 0x01>;
	hisi,chiptype = "HUAWEI Kirin 990_cs";

	fastboot_pmic {
		compatible = "fastboot,hisi-pmic";
		hisilicon,init-reg-num = <0x04>;
		hisilicon,init-reg-addrs = <0x18c 0x189 0x18a 0x2e9>;
		hisilicon,init-reg-vals = <0x02 0x03 0x03 0x03>;
		phandle = <0x4e0>;
	};

	fastboot_pmic_mntn {
		compatible = "fastboot,hisi-pmic-mntn";
		hisilicon,data-width = <0x08>;
		hisilicon,record-reg-num = <0x0f>;
		hisilicon,record-regs = <0x2c4 0x2c5 0x2c6 0x2c7 0x2c8 0x2c9 0x2ca 0x2cb 0x2cc 0x2cd 0x2ce 0x2cf 0x2d0 0x2d1 0x2d2>;
		phandle = <0x4e1>;

		RECORD@2C4 {
			compatible = "hisilicon,pmic-mntn-record-reg0x2C4";
			hisilicon,inacceptable-event = <0xff>;
			hisilicon,except-type = <0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01>;
			hisilicon,except-subtype = <0x01 0x02 0x03 0x04 0x05 0x06 0x07 0x08>;
			hisilicon,event-bit-name = "ocp_buck00", "ocp_buck01", "ocp_buck10", "ocp_buck1", "ocp_buck2", "ocp_buck3", "ocp_buck4", "ocp_buck5";
		};

		RECORD@2C5 {
			compatible = "hisilicon,pmic-mntn-record-reg0x2C5";
			hisilicon,inacceptable-event = <0xff>;
			hisilicon,except-type = <0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01>;
			hisilicon,except-subtype = <0x09 0x0a 0x0b 0x0c 0x0d 0x0e 0x0f 0x10>;
			hisilicon,event-bit-name = "ocp_ldo3", "ocp_ldo2", "ocp_ldo1", "ocp_ldo0", "ocp_buck6", "ocp_buck7", "ocp_buck8", "ocp_buck9";
		};

		RECORD@2C6 {
			compatible = "hisilicon,pmic-mntn-record-reg0x2C6";
			hisilicon,inacceptable-event = <0xb8>;
			hisilicon,except-type = <0x00 0x00 0x00 0x01 0x01 0x01 0x00 0x01>;
			hisilicon,except-subtype = <0x00 0x00 0x00 0x11 0x12 0x13 0x00 0x14>;
			hisilicon,event-bit-name = "ocp_ldo12", "ocp_ldo11", "ocp_ldo9", "ocp_ldo8", "ocp_ldo7", "ocp_ldo6", "reserved", "ocp_ldo4";
		};

		RECORD@2C7 {
			compatible = "hisilicon,pmic-mntn-record-reg0x2C7";
			hisilicon,inacceptable-event = <0xdf>;
			hisilicon,except-type = <0x01 0x01 0x01 0x01 0x01 0x00 0x01 0x01>;
			hisilicon,except-subtype = <0x15 0x16 0x17 0x18 0x19 0x00 0x1a 0x1b>;
			hisilicon,event-bit-name = "ocp_ldo23", "ocp_ldo22", "ocp_ldo21", "ocp_ldo18", "ocp_ldo17", "ocp_ldo16", "ocp_ldo15", "ocp_ldo14";
		};

		RECORD@2C8 {

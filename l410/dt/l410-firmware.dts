		compatible = "hisilicon,ddr_devfreq";
		reg = <0x00 0xfffc0000 0x00 0x10000>;
		pm_qos_data_reg = <0x10 0x3c>;
		clocks = <0x03 0x04>;
		pm_qos_class = "memory_tput";
		operating-points = <0x65518 0x00 0xdbba0 0x00 0x10e050 0x00 0x14e790 0x00 0x195460 0x00 0x1b7740 0x00 0x208c08 0x00>;

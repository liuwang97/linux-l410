			hisilicon,except-type = <0x01 0x01 0x01 0x01 0x01 0x01 0x01 0x01>;
			hisilicon,except-subtype = <0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23>;
			hisilicon,event-bit-name = "ocp_ldo32", "ocp_ldo30", "ocp_ldo29", "ocp_ldo28", "ocp_ldo27", "ocp_ldo26", "ocp_ldo25", "ocp_ldo24";
		};

		RECORD@2C9 {
			compatible = "hisilicon,pmic-mntn-record-reg0x2C9";
			hisilicon,inacceptable-event = <0xfb>;
			hisilicon,except-type = <0x01 0x01 0x00 0x01 0x01 0x01 0x01 0x01>;
			hisilicon,except-subtype = <0x24 0x25 0x00 0x26 0x27 0x28 0x29 0x2a>;
			hisilicon,event-bit-name = "ocp_ldo41", "ocp_ldo40", "reserved", "ocp_ldo38", "ocp_ldo37", "ocp_ldo36", "ocp_pmuh", "ocp_ldo34";
		};

		RECORD@2CA {

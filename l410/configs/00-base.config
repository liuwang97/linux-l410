# Huawei L410 (Kirin 990) — merged on top of arm64 defconfig by scripts/build.sh
CONFIG_LOCALVERSION="-l410"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_ARCH_HISI=y

# boot: plain Image (GRUB 2.04 needs the arm64 Image header, no zboot)
CONFIG_EFI=y
CONFIG_EFI_STUB=y
# CONFIG_EFI_ZBOOT is not set
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

# console: UEFI GOP framebuffer via simpledrm
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# crash logs: ramoops region shared with the vendor kernel (0x26e00000, 1 MiB)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_PSTORE_COMPRESS=y
CONFIG_DEBUG_FS=y

# unattended bring-up
CONFIG_L410_DEADMAN=y
# CONFIG_ARM_SP805_WATCHDOG is not set

# kept off until the matching SoC support exists (they would bind vendor DT nodes)
# CONFIG_ARM_PSCI_CPUIDLE is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_CORESIGHT is not set
# CONFIG_I3C is not set
# CONFIG_USB_DWC3 is not set
# CONFIG_POWER_RESET_HISI is not set
# CONFIG_ARM_SMMU_V3 is not set

# Debian userspace
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_AUTOFS_FS=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_FANOTIFY=y
CONFIG_SECCOMP=y
CONFIG_ZRAM=m

# USB network used for ssh (RTL8153)
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_RTL8152=y
CONFIG_USB_USBNET=y

# Desktop memory: zswap (zstd) in front of a UFS swapfile, multi-gen LRU, THP only on request
# (docs/tuning/memory.md in l410-mainline; the run-time knobs are set by its system/mem/mem-tune)

# compressed swap cache: on at boot, zstd, writes cold pages back to the swapfile on its own
CONFIG_ZSWAP=y
CONFIG_ZSWAP_DEFAULT_ON=y
CONFIG_ZSWAP_SHRINKER_DEFAULT_ON=y
CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y
CONFIG_ZSMALLOC=y
CONFIG_CRYPTO_ZSTD=y

# multi-gen LRU (min_ttl_ms keeps the working set, else OOM instead of thrashing)
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# transparent huge pages only for madvise() users: no synchronous compaction in page faults
# CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS is not set
CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y

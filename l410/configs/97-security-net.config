# Security baseline and network features a Debian desktop expects
# (l410-mainline docs/testing/test-plan.md BLD-04, SEC-02, SEC-06; checked by tests/quick.sh
# cfg.hardening/lsm/netfilter/vpn/storage)

# hardening: /dev/mem cannot reach MMIO that a driver owns; bounds-checked string/memory
# helpers; copy_{to,from}_user checked against slab and stack objects
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y

# LSMs as in Debian's kernel: AppArmor (Debian's default profiles), Yama ptrace scope, Landlock
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,apparmor,ipe,bpf"

# nftables (NetworkManager connection sharing, firewalld/ufw through iptables-nft)
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_QUOTA=m
CONFIG_NFT_CONNLIMIT=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NF_NAT=m
CONFIG_NETFILTER_XT_NAT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m

# VPN: WireGuard, IPsec (strongSwan/libreswan), L2TP/PPP
CONFIG_WIREGUARD=m
CONFIG_XFRM_USER=m
CONFIG_XFRM_INTERFACE=m
CONFIG_INET_ESP=m
CONFIG_INET6_ESP=m
CONFIG_L2TP=m
CONFIG_PPPOL2TP=m
CONFIG_PPPOE=m
CONFIG_PPP_MPPE=m

# LUKS volumes (encrypted USB disks)
CONFIG_DM_CRYPT=m
CONFIG_CRYPTO_XTS=y

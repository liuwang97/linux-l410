# T4 USB: Kirin 990 DWC3 host + USB 3.1/DP combo PHY, RTS5411 hub power, RTL8153
CONFIG_USB=y
CONFIG_USB_ANNOUNCE_NEW_DEVICES=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PLATFORM=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_KIRIN990=y
CONFIG_PHY_KIRIN990_USB3=y
CONFIG_USB_ONBOARD_DEV=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_GPIO_PL061=y
# combo PHY SRAM image (l410/firmware/hisilicon/kirin990-usb31phy.bin)
CONFIG_EXTRA_FIRMWARE="hisilicon/kirin990-usb31phy.bin"
CONFIG_EXTRA_FIRMWARE_DIR="l410/firmware"
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y

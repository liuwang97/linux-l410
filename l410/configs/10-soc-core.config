# SoC core: clocks, IPC mailbox, hwspinlock, pinctrl/GPIO, I2C, SPI, UART
CONFIG_COMMON_CLK_KIRIN990=y
CONFIG_MAILBOX=y
CONFIG_KIRIN_IPC_MBOX=y
CONFIG_HWSPINLOCK=y
CONFIG_HWSPINLOCK_KIRIN=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_SINGLE=y
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=y
CONFIG_I2C_DESIGNWARE_CORE=y
CONFIG_I2C_DESIGNWARE_PLATFORM=y
CONFIG_SPI=y
CONFIG_SPI_PL022=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_DMADEVICES=y
CONFIG_HISI_DMA64=y
# DMA self-test hook (does nothing until /sys/module/dmatest/parameters/run is set)
CONFIG_DMATEST=y

# Performance and power (docs/tuning/perf-power.md in l410-mainline)

# uclamp: KWin's real-time threads on the big cores, foreground app floors
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_UCLAMP_BUCKETS_COUNT=5

# energy model (cpufreq from the vendor energy tables, GPU from its OPPs): EAS
CONFIG_ENERGY_MODEL=y
CONFIG_THERMAL_GOV_POWER_ALLOCATOR=y

# modes and interaction boosts: /sys/kernel/l410_perf
CONFIG_L410_PERF=y
CONFIG_DEVFREQ_GOV_PERFORMANCE=y
CONFIG_DEVFREQ_GOV_POWERSAVE=y
CONFIG_DEVFREQ_GOV_USERSPACE=y

# observability: sched/irq/dma_fence/drm tracepoints, pressure stall info
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
# CONFIG_FUNCTION_TRACER is not set
# CONFIG_STACK_TRACER is not set
CONFIG_PSI=y
CONFIG_SCHEDSTATS=y

# DDR frequency scaling through the PMCTRL vote (starts at the fastest OPP)
CONFIG_ARM_KIRIN990_DDR_DEVFREQ=y

# input injection for the input boost test (l410-mainline tests/perf.sh)
CONFIG_INPUT_UINPUT=y
# System sleep debugging: /sys/power/pm_test, pm_debug_messages, pm_print_times
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
# deep system suspend through the vendor LPM3 handshake
CONFIG_KIRIN990_SUSPEND=y

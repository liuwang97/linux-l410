# sched_ext: BPF schedulers (scx_lavd, scx_bpfland) can be loaded at run time.
# The kernel loads none by itself; without a loaded scheduler everything stays on EEVDF/EAS.
# l410-mainline's system/sched-ext starts scx_lavd at boot (docs/tuning/sched-ext.md there).

# BTF needs full DWARF (arm64 defconfig builds reduced debug info)
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_SCHED_CLASS_EXT=y
# listed as required by sched-ext/scx (no interpreter fallback)
CONFIG_BPF_JIT_ALWAYS_ON=y
# scx_lavd boosts futex holders through fexit (needs FUNCTION_TRACER, off in 90-perf)
# or else the futex syscall tracepoints
CONFIG_FTRACE_SYSCALLS=y
# a module rebuilt alone and dropped onto an installed kernel (hi110x.ko) must still load
# when its split BTF no longer matches that kernel
CONFIG_MODULE_ALLOW_BTF_MISMATCH=y

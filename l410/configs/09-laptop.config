# T9 laptop: EC (echub), I2C-HID keyboard and touchpad, lid switch
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_OF=y
CONFIG_INPUT_EVDEV=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_MFD_HUAWEI_ECHUB=y
CONFIG_POWER_SUPPLY=y
CONFIG_BATTERY_HUAWEI_ECHUB=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_HUAWEI_ECHUB=y

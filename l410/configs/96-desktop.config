# Debian desktop: removable media, network shares, USB/Bluetooth peripherals, WWAN, qdisc,
# lockup detection (docs/kernel-config.md in l410-mainline), udmabuf for KWin 6.7

# removable media and Chinese file names
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_ZISOFS=y
CONFIG_UDF_FS=m
CONFIG_BLK_DEV_SR=m
CONFIG_CHR_DEV_SG=m
CONFIG_NLS_UTF8=m
CONFIG_NLS_CODEPAGE_936=m
CONFIG_NLS_CODEPAGE_950=m
CONFIG_NLS_ASCII=m

# network shares
CONFIG_CIFS=m

# USB peripherals
CONFIG_SND_USB_AUDIO=m
CONFIG_USB_UAS=m
CONFIG_USB_PRINTER=m
CONFIG_USB_SERIAL_GENERIC=y
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
CONFIG_USB_SERIAL_SIMPLE=m
CONFIG_USB_NET_RNDIS_HOST=m

# Bluetooth: headset calls (RFCOMM), PAN (BNEP), BLE keyboards and mice (UHID)
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=m
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_UHID=m
CONFIG_HID_BATTERY_STRENGTH=y

# HID and input
CONFIG_HIDRAW=y
CONFIG_USB_HIDDEV=y
CONFIG_INPUT_JOYDEV=m
CONFIG_INPUT_JOYSTICK=y
CONFIG_JOYSTICK_XPAD=m
CONFIG_HID_WACOM=m

# 4G modems
CONFIG_USB_NET_HUAWEI_CDC_NCM=m
CONFIG_USB_NET_CDC_MBIM=m
CONFIG_USB_NET_QMI_WWAN=m
CONFIG_USB_WDM=m
CONFIG_USB_SERIAL_QUALCOMM=m
CONFIG_PPP=m
CONFIG_PPP_ASYNC=m
CONFIG_PPP_SYNC_TTY=m
CONFIG_PPP_DEFLATE=m
CONFIG_PPP_BSDCOMP=m

# queueing: systemd sets net.core.default_qdisc=fq_codel
CONFIG_NET_SCH_FQ_CODEL=m
CONFIG_NET_SCH_FQ=m

# MIDI
CONFIG_SND_SEQUENCER=m

# lockup detection: report only, the watchdog still does the resets
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_WQ_WATCHDOG=y

# KWin 6.7 imports wl_shm client buffers through /dev/udmabuf instead of uploading them
# every frame (KWin MR !9178; docs/tuning/desktop.md in l410-mainline)
CONFIG_UDMABUF=y

# no tracefs automount under /sys/kernel/debug/tracing (deprecated, removal planned for 2030):
# libbpf in scx_lavd probes that path first, and the automount logs a deprecation notice at
# every boot; with it gone libbpf uses /sys/kernel/tracing, which systemd mounts
# CONFIG_TRACEFS_AUTOMOUNT_DEPRECATED is not set
